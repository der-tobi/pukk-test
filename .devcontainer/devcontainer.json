// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "pukk-test",

  "initializeCommand": "mkdir -p ${localEnv:HOME}/.claude ${localEnv:HOME}/.codex ${localEnv:HOME}/.config/gh && touch ${localEnv:HOME}/.claude.json",

  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",

  "mounts": [
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/.devcontainer/codex-config.toml,target=/home/vscode/.codex/config.toml,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/vscode/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/vscode/.config/gh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/projects/microfast,target=/workspaces/rooms-q-and-a/basis,type=bind,consistency=cached,readonly"
  ],

  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },

  "postCreateCommand": "bash ./.devcontainer/post-create.sh",
  // "postCreateCommand": "",
  "postStartCommand": "bash ./.devcontainer/update-skills.sh",

  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "go.toolsManagement.autoUpdate": true
      },
      "extensions": [
        "ms-vscode-remote.remote-containers",
        "ms-vscode-remote.remote-wsl",
        "golang.go",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
